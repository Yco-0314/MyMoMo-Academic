    "landscape_seed_base": 0,
    "walk_seed_base": 0,
    "enumeration": "all 2^15 = 32768 genotypes enumerated per landscape",
    "construction": "N binary loci; each locus i's contribution f_i depends on its own allele + K OTHER loci (chosen at random per locus, fixed per landscape seed); f_i ~ U[0,1] keyed deterministically on (seed, locus, the K+1 relevant bits); fitness(genotype) = mean of the N contributions",
    "local_optimum": "a genotype whose fitness is >= all N single-bit-flip (Hamming-1) neighbours",
    "adaptive_walk": "greedy steepest-ascent: from a random start, repeatedly move to the FITTEST strictly-fitter 1-flip neighbour until none exists (a local optimum); length = #accepted moves",
    "metrics": "(1) #local optima (enumerated); (2) mean greedy-walk length; both averaged over the random landscapes per K",
    "analytic_anchor": "random-landscape (K=N-1) #optima expectation 2^N/(N+1) = 2048.0; never fed into the dynamics"
  },
