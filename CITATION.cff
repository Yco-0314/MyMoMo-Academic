date-released: "2026-06-14"
license: Apache-2.0
repository-code: "https://github.com/Yco-0314/MyMoMo-Academic"
url: "https://github.com/Yco-0314/MyMoMo-Academic"
keywords:
  - agent-based modeling
  - agent-based simulation
  - calibration
  - large language models
  - computational social science
  - reproducibility
  - Python
